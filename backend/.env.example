# HealthBridge backend configuration — copy to `.env` and fill in real values.
# Never commit the real .env. Generate secrets with e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"

# Keyed HMAC for Step 3 ID tokenisation (BRD §6). Must stay constant so AHC and
# HRMS map the same employee to the same token; rotating it breaks past matches.
HMAC_SECRET_KEY=replace-with-32-byte-hex

# JWT signing for auth (BRD §5).
JWT_SECRET=replace-with-32-byte-hex
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# SQLite store for users, uploads, and group results.
DATABASE_URL=sqlite:///./healthbridge.db

# Comma-separated frontend origins allowed by CORS.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
